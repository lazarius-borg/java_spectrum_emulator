<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rootPane"
            fx:controller="com.spectrum.ui.SpectrumController"
            stylesheets="@retro.css"
            prefWidth="960" prefHeight="780">

    <!-- Top Menu Bar -->
    <top>
        <MenuBar fx:id="menuBar">
            <Menu text="File">
                <MenuItem text="Open Snapshot (.SNA, .Z80)..." onAction="#handleOpenSnapshot"/>
                <MenuItem text="Save Snapshot (.SNA)..." onAction="#handleSaveSnapshot"/>
                <SeparatorMenuItem/>
                <MenuItem text="Insert Tape (.TAP)..." onAction="#handleOpenTape"/>
                <MenuItem text="Load ROM File..." onAction="#handleLoadRom"/>
                <SeparatorMenuItem/>
                <MenuItem text="Exit" onAction="#handleExit"/>
            </Menu>

            <Menu text="Machine">
                <fx:define>
                    <ToggleGroup fx:id="modelGroup"/>
                </fx:define>
                <RadioMenuItem fx:id="m128k" text="ZX Spectrum 128K" toggleGroup="$modelGroup" selected="true" onAction="#handleModel128K"/>
                <RadioMenuItem fx:id="m48k" text="ZX Spectrum 48K" toggleGroup="$modelGroup" onAction="#handleModel48K"/>
                <SeparatorMenuItem/>
                <MenuItem text="Reset" onAction="#handleReset"/>
                <CheckMenuItem fx:id="pauseItem" text="Pause" onAction="#handlePause"/>
                <CheckMenuItem fx:id="fastForwardItem" text="Fast Forward (Turbo)" onAction="#handleFastForward"/>
            </Menu>

            <Menu text="Input">
                <fx:define>
                    <ToggleGroup fx:id="joyGroup"/>
                </fx:define>
                <RadioMenuItem fx:id="kempstonItem" text="Kempston Joystick (Port 0x1F)" toggleGroup="$joyGroup" selected="true" onAction="#handleKempstonSelected"/>
                <RadioMenuItem fx:id="sinclair1Item" text="Sinclair 1 (6, 7, 8, 9, 0)" toggleGroup="$joyGroup" onAction="#handleSinclair1Selected"/>
                <RadioMenuItem fx:id="sinclair2Item" text="Sinclair 2 (1, 2, 3, 4, 5)" toggleGroup="$joyGroup" onAction="#handleSinclair2Selected"/>
                <RadioMenuItem fx:id="cursorItem" text="Cursor / Protek (5, 6, 7, 8, 0)" toggleGroup="$joyGroup" onAction="#handleCursorSelected"/>
                <SeparatorMenuItem/>
                <Menu fx:id="profileMenu" text="Host Keyboard Profile"/>
                <SeparatorMenuItem/>
                <MenuItem text="Joystick Settings &amp; Tester..." onAction="#handleJoystickSettings"/>
            </Menu>

            <Menu text="Audio">
                <CheckMenuItem fx:id="audioEnableItem" text="Enable Audio" selected="true" onAction="#handleAudioToggle"/>
                <SeparatorMenuItem/>
                <MenuItem text="Volume: 100%" onAction="#handleVolume100"/>
                <MenuItem text="Volume: 75%" onAction="#handleVolume75"/>
                <MenuItem text="Volume: 50%" onAction="#handleVolume50"/>
            </Menu>

            <Menu text="View">
                <CheckMenuItem fx:id="showLibraryMenu" text="Show Tape Library" selected="true" onAction="#toggleLibraryFromMenu"/>
                <CheckMenuItem fx:id="showKeyboardMenu" text="Show On-Screen Keyboard" selected="true" onAction="#toggleKeyboardFromMenu"/>
                <CheckMenuItem fx:id="showJoystickMenu" text="Show On-Screen Joystick" selected="true" onAction="#toggleJoystickFromMenu"/>
                <CheckMenuItem fx:id="showInspectorMenu" text="Show Inspector" selected="true" onAction="#toggleInspectorFromMenu"/>
            </Menu>

            <Menu text="Help">
                <MenuItem text="Keyboard &amp; Joystick Guide..." onAction="#handleKeyboardHelp"/>
                <SeparatorMenuItem/>
                <MenuItem text="About ZX Spectrum Emulator" onAction="#handleAbout"/>
            </Menu>
        </MenuBar>
    </top>

    <!-- Center Workspace -->
    <center>
        <VBox spacing="6">
            <padding>
                <Insets top="6" right="6" bottom="6" left="6"/>
            </padding>

            <!-- Main Display, Library & Inspector Split Area -->
            <HBox spacing="6" VBox.vgrow="ALWAYS">
                <!-- Left: Tape Library Panel -->
                <VBox fx:id="libraryPanel" styleClass="retro-panel" prefWidth="240" minWidth="180" maxWidth="300">
                    <HBox styleClass="retro-panel-header" alignment="CENTER_LEFT">
                        <Label text="-[ 💾 Tape Library ]-" styleClass="panel-title-library"/>
                    </HBox>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <padding>
                            <Insets top="4" bottom="4" left="2" right="2"/>
                        </padding>
                        <Button text="+ Add" onAction="#handleAddTapeToLibrary" styleClass="retro-btn"/>
                        <Button text="⏏ Insert" onAction="#handleInsertSelectedTape" styleClass="retro-btn"/>
                        <Button text="🗑 Remove" onAction="#handleRemoveTapeFromLibrary" styleClass="retro-btn"/>
                    </HBox>
                    <ListView fx:id="tapeListView" styleClass="tape-list-view" VBox.vgrow="ALWAYS"/>
                </VBox>

                <!-- Center: ZX Spectrum Display Panel -->
                <VBox fx:id="screenPanel" styleClass="retro-panel" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <HBox styleClass="retro-panel-header" alignment="CENTER_LEFT">
                        <Label text="-[ 📺 ZX Spectrum Display ]-" styleClass="panel-title-screen"/>
                    </HBox>
                    <StackPane fx:id="screenContainer" VBox.vgrow="ALWAYS" alignment="CENTER" minHeight="240"/>
                </VBox>

                <!-- Right: Inspector Panel -->
                <StackPane fx:id="inspectorContainer"/>
            </HBox>

            <!-- Bottom: Input Deck (Keyboard on Left, Joystick next to it on Right) -->
            <HBox fx:id="inputDeckPanel" spacing="6" alignment="CENTER">
                <!-- Keyboard Panel -->
                <VBox fx:id="keyboardPanel" styleClass="retro-panel" HBox.hgrow="ALWAYS">
                    <HBox styleClass="retro-panel-header" alignment="CENTER_LEFT">
                        <Label text="-[ ⌨ ZX Spectrum Keyboard ]-" styleClass="panel-title-keyboard"/>
                    </HBox>
                    <StackPane fx:id="keyboardContainer" alignment="CENTER"/>
                </VBox>

                <!-- Joystick Panel -->
                <VBox fx:id="joystickPanel" styleClass="retro-panel" alignment="CENTER">
                    <HBox styleClass="retro-panel-header" alignment="CENTER_LEFT">
                        <Label text="-[ 🕹 Arcade Joystick ]-" styleClass="panel-title-joystick"/>
                    </HBox>
                    <StackPane fx:id="joystickContainer" alignment="CENTER"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- Bottom: Transport Controls & Status Bar -->
    <bottom>
        <HBox fx:id="bottomBar" styleClass="retro-bottom-bar" spacing="8" alignment="CENTER_LEFT">
            <!-- Tape Transport Buttons -->
            <Button fx:id="btnPlay" text="▶ Play" onAction="#handlePlay" styleClass="retro-btn, retro-btn-play"/>
            <Button fx:id="btnPause" text="⏸ Pause" onAction="#handleTapePause" styleClass="retro-btn, retro-btn-pause"/>
            <Button fx:id="btnStop" text="⏹ Stop" onAction="#handleTapeStop" styleClass="retro-btn, retro-btn-stop"/>
            <Button fx:id="btnRewind" text="⏮ Rewind" onAction="#handleTapeRewind" styleClass="retro-btn, retro-btn-rewind"/>
            <CheckBox fx:id="chkInstant" text="Instant Load" onAction="#handleInstantLoadToggle" selected="true" style="-fx-text-fill: #ffd700;"/>

            <Separator orientation="VERTICAL"/>

            <!-- View Toggles -->
            <ToggleButton fx:id="btnToggleLibrary" text="☰ Library" onAction="#toggleLibraryFromButton" selected="true" styleClass="retro-toggle-btn"/>
            <ToggleButton fx:id="btnToggleKeyboard" text="⌨ Keyboard" onAction="#toggleKeyboardFromButton" selected="true" styleClass="retro-toggle-btn"/>
            <ToggleButton fx:id="btnToggleJoystick" text="🕹 Joystick" onAction="#toggleJoystickFromButton" selected="true" styleClass="retro-toggle-btn"/>
            <ToggleButton fx:id="btnToggleInspector" text="⚙ Inspector" onAction="#toggleInspectorFromButton" selected="true" styleClass="retro-toggle-btn"/>

            <Separator orientation="VERTICAL"/>

            <!-- Tape Status -->
            <Label fx:id="tapeLabel" text="Tape: None" styleClass="badge-tape"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Machine Status -->
            <Label fx:id="statusLabel" text="RAM 0 | ROM 0 | Screen 5" styleClass="badge-status"/>

            <Separator orientation="VERTICAL"/>

            <!-- FPS Counter -->
            <Label fx:id="fpsLabel" text="50.0 FPS" styleClass="badge-fps"/>
        </HBox>
    </bottom>
</BorderPane>
